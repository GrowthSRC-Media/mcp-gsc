# =============================================================================
# GSC MCP Server — Environment Configuration
# Copy this file to .env and fill in your values before starting the server.
# =============================================================================


# ─── Server ───────────────────────────────────────────────────────────────────

# Port the server listens on inside the container / on the host
PORT=8080

# Public URL where this server is reachable (no trailing slash)
# Used to build the OAuth redirect URI and shown to users on the setup page.
#   Local dev  → http://localhost:8080
#   VPS/prod   → https://mcp.yourdomain.com  (must use HTTPS for production)
SERVER_URL=http://localhost:8080

# Transport mode
#   sse   → HTTP/SSE server for VPS hosting (multi-user, default)
#   stdio → local stdio server for Claude Desktop direct use (single user)
MCP_TRANSPORT=sse


# ─── Storage ──────────────────────────────────────────────────────────────────

# Directory where the server stores all persistent data:
#   tokens/              per-user OAuth token files (auto-created)
#   oauth_states.json    transient OAuth state (auto-created)
#
# Docker default  → /data  (mount ./data:/data in docker-compose.yml)
# Local default   → same directory as gsc_server.py
DATA_DIR=./data


# ─── Google OAuth ─────────────────────────────────────────────────────────────
#
# These values replace the client_secrets.json file entirely.
# Every field that Google puts in the downloaded JSON is available here as an ENV var.
#
# Where to find these values:
#   Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID
#
# For SSE/VPS mode: use "Web application" credential type and register this redirect URI:
#   {SERVER_URL}/oauth/callback   e.g. https://mcp.yourdomain.com/oauth/callback
#
# For stdio/local mode: use "Desktop app" credential type.
#
# Required:
GSC_OAUTH_CLIENT_ID=your_client_id_here
GSC_OAUTH_CLIENT_SECRET=your_client_secret_here

# Optional — copy from the downloaded JSON if you need them, otherwise defaults are used:
GSC_OAUTH_PROJECT_ID=your_project_id_here
GSC_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GSC_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GSC_OAUTH_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# GSC_OAUTH_JAVASCRIPT_ORIGINS=https://yourdomain.com


# ─── Service account (optional — alternative to per-user OAuth) ───────────────

# Uncomment and set if you want to use a service account instead of OAuth.
# Useful for a private team server where everyone shares one GSC account.
# GSC_CREDENTIALS_PATH=./data/service_account_credentials.json

# Set to true to skip the OAuth flow entirely and use only the service account.
# GSC_SKIP_OAUTH=false


# ─── Data freshness ───────────────────────────────────────────────────────────

# Controls how fresh the search analytics data is.
#   all   → includes unconfirmed data, matches what you see in the GSC dashboard (default)
#   final → confirmed data only, lags 2-3 days behind the dashboard
GSC_DATA_STATE=all
